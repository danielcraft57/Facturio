# Marketing / Playwright — captures, clips et workflow
# Copier vers docs/marketing/.env et ajuster si besoin.

# --- Screenshots (aligné config Celery / Playwright) ---
# WEBSITE_SCREENSHOTS_DIR=
# WEBSITE_SCREENSHOTS_BASE_URL=/static/screenshots/website_previews
WEBSITE_SCREENSHOT_WAIT_MS=700
WEBSITE_SCREENSHOT_GOTO_WAIT_UNTIL=domcontentloaded
WEBSITE_SCREENSHOT_GOTO_TIMEOUT_MS=28000
WEBSITE_SCREENSHOT_WEBP_QUALITY=78
WEBSITE_SCREENSHOT_VIEWPORT_DESKTOP_WIDTH=1920
WEBSITE_SCREENSHOT_VIEWPORT_DESKTOP_HEIGHT=2400
WEBSITE_SCREENSHOT_VIEWPORT_TABLET_WIDTH=1024
WEBSITE_SCREENSHOT_VIEWPORT_TABLET_HEIGHT=2500
WEBSITE_SCREENSHOT_VIEWPORT_MOBILE_WIDTH=430
WEBSITE_SCREENSHOT_VIEWPORT_MOBILE_HEIGHT=2500
WEBSITE_SCREENSHOT_MAX_WIDTH_DESKTOP=1600
WEBSITE_SCREENSHOT_MAX_WIDTH_TABLET=1200
WEBSITE_SCREENSHOT_MAX_WIDTH_MOBILE=800
WEBSITE_SCREENSHOT_KEEP_SETS=5
WEBSITE_SCREENSHOT_CLEANUP_BATCH_SIZE=1500
WEBSITE_SCREENSHOT_PARALLEL=true
WEBSITE_SCREENSHOT_CAPTURE_FORMAT=png
WEBSITE_SCREENSHOT_JPEG_QUALITY=82
WEBSITE_SCREENSHOT_DEVICE_SCALE_FACTOR=1
WEBSITE_SCREENSHOT_BLOCK_TRACKERS=true
WEBSITE_SCREENSHOT_REDUCED_MOTION=true
WEBSITE_SCREENSHOT_DISABLE_ANIMATIONS=true

# Profil viewport pour PrestaFacture (desktop | tablet | mobile)
MARKETING_SCREENSHOT_PROFILE=desktop

# Vidéo showreel (viewport 16:9 — scroll dans la page, pas viewport 2400px)
MARKETING_VIDEO_VIEWPORT_WIDTH=1600
MARKETING_VIDEO_VIEWPORT_HEIGHT=900
MARKETING_VIDEO_WAIT_MS=200
MARKETING_VIDEO_SCROLL_MAX_STEPS=5
MARKETING_VIDEO_SCENE_HOLD_MS=1200
MARKETING_VIDEO_SCENE_PACE_MS=320
MARKETING_VIDEO_AUTO_TRIM=true
MARKETING_VIDEO_TRIM_START_SEC=0
MARKETING_VIDEO_TRANSITION_MENU_MS=520
MARKETING_VIDEO_TRANSITION_ROUTE_MS=340
MARKETING_VIDEO_TRANSITION_FADE_MS=320

# Scroll dans les clips / workflow vidéo
WEBSITE_SCREENSHOT_SCROLL_ENABLED=true
WEBSITE_SCREENSHOT_SCROLL_STEP_PX=480
WEBSITE_SCREENSHOT_SCROLL_PAUSE_MS=140
WEBSITE_SCREENSHOT_SCROLL_MAX_STEPS=14
