# ========================================
# FACTURIO FRONTEND - PRODUCTION
# ========================================
# Copier vers .env sur le serveur de production

# URL de l'API backend (production)
# Utiliser l'URL HTTPS publique avec le domaine
VITE_API_URL=https://facturio.danielcraft.fr/api

# Activer les mocks (false en production)
VITE_USE_MOCK=false

# Environnement (production)
VITE_ENV=production

# URL publique de l'application (pour les liens publics)
VITE_PUBLIC_APP_URL=https://facturio.danielcraft.fr

# HMR derriere reverse proxy HTTPS (uniquement si tu lances "npm run dev" sur le serveur)
# VITE_HMR_HOST=facturio.danielcraft.fr
# VITE_HMR_CLIENT_PORT=443
# VITE_HMR_PROTOCOL=wss
