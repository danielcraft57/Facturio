# ========================================
# PRESTAFACTURE FRONTEND - PRODUCTION
# ========================================
# Build : npm run build (Vite lit ce fichier au moment du build)
# CI : copié vers .env.production avant le build GitHub Actions
#
# Pas besoin de mettre votre domaine ici : l’API utilise un chemin relatif (/api)
# et l’URL publique de l’app peut être déduite du navigateur (window.location.origin).
# Secret GitHub optionnel : PRESTAFACTURE_PUBLIC_APP_URL (voir .github/workflows/ci.yml)

VITE_API_URL=/api
VITE_USE_MOCK=false
VITE_ENV=production

# Google Analytics 4 (actif automatiquement en build production)
# VITE_GA_MEASUREMENT_ID=G-TVDKVFYP25

# URL canonique / Open Graph en production (recommandé pour le SEO — canonical, og:url)
VITE_SITE_URL=https://prestafacture.com

# Marque affichée dans les titres (ex. Devis, PrestaFacture).
VITE_APP_NAME=PrestaFacture

# Uniquement si une URL absolue est requise au build (rare) — sinon laisser commenté
# VITE_PUBLIC_APP_URL=

# Alternative API sur un autre hôte
# VITE_API_URL=https://votre-domaine.example/api

# HMR derriere reverse proxy HTTPS (uniquement si tu lances "npm run dev" sur le serveur)
# VITE_HMR_HOST=
# VITE_HMR_CLIENT_PORT=443
# VITE_HMR_PROTOCOL=wss
