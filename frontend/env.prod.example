# ========================================
# FACTURIO FRONTEND - PRODUCTION
# ========================================
# Build : npm run build (Vite lit ce fichier au moment du build)
# Sur le serveur : copier vers frontend/.env.production.local ou exporter avant build

VITE_API_URL=https://facturio.YOUR_DOMAIN/api
VITE_USE_MOCK=false
VITE_ENV=production
VITE_PUBLIC_APP_URL=https://facturio.YOUR_DOMAIN

# HMR derriere reverse proxy HTTPS (uniquement si tu lances "npm run dev" sur le serveur)
# VITE_HMR_HOST=facturio.danielcraft.fr
# VITE_HMR_CLIENT_PORT=443
# VITE_HMR_PROTOCOL=wss
