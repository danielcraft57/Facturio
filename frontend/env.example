# Variables d'environnement Frontend

# URL de l'API backend (proxy Vite en dev : /api)
VITE_API_URL=http://localhost:3000/api

# URL publique du site (canonical, Open Graph) — ex. https://prestafacture.com
# VITE_SITE_URL=http://localhost:5173

# Nom de marque dans les titres / OG (vide = titre seul ; non défini = dérivé du sous-domaine)
VITE_APP_NAME=PrestaFacture

# URL publique pour webhooks Stripe (optionnel — sinon dérivée de VITE_API_URL)
# Doit correspondre à API_PUBLIC_URL côté serveur si vous utilisez un tunnel / domaine.
# VITE_API_PUBLIC_URL=https://prestafacture.com

# Activer les mocks (true/false)
VITE_USE_MOCK=false

# Environnement (development, production)
VITE_ENV=development

# Google Analytics 4 — désactivé en dev par défaut (évite de polluer les stats)
# VITE_GA_MEASUREMENT_ID=G-TVDKVFYP25
# VITE_GA_ENABLED=true

# Stripe : les paiements de factures utilisent la clé publishable du prestataire
# renvoyée par l'API (checkout public). VITE_STRIPE_PUBLISHABLE_KEY n'est plus requis.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

