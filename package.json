{
  "name": "PrestaFacture",
  "version": "1.4.3",
  "private": true,
  "description": "Application de facturation complète",
  "scripts": {
    "start:all": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run start:dev --prefix server\" \"npm run dev --prefix frontend\"",
    "start:all:prod": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run start:prod --prefix server\" \"npm run preview --prefix frontend\"",
    "build:all": "npm run build --prefix server && npm run build --prefix frontend",
    "install:all": "npm install --prefix server && npm install --prefix frontend",
    "test:all": "npm run test --prefix server && npm run test --prefix frontend",
    "test:e2e": "npm run test:e2e --prefix server",
    "seed:dev": "npm run seed:dev --prefix server",
    "seed:playwright": "npm run seed:playwright --prefix server",
    "marketing:capture": "node docs/marketing/scripts/capture-marketing-screenshots.mjs",
    "demo:capture": "node docs/marketing/scripts/capture-demo-screenshots.mjs",
    "marketing:clips": "node docs/marketing/scripts/record-marketing-clips.mjs",
    "marketing:workflow": "node docs/marketing/scripts/record-workflow-demo.mjs",
    "marketing:tts": "python scripts/marketing/generate_facturio_marketing_tts.py --variant all --concat-full",
    "marketing:video": "python scripts/marketing/build_pub_video.py --variant 30s-main",
    "marketing:clean": "node docs/marketing/scripts/clean-marketing-legacy.mjs",
    "marketing:mobile-ux": "node docs/marketing/scripts/playwright-marketing-mobile-ux.mjs",
    "email:preview": "npm run preview:emails --prefix server",
    "start:mobile": "npm run start --prefix mobile",
    "test:mobile": "npm test --prefix mobile"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
