{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-pdf-assets.js",
    "build:prod": "prisma generate --schema=prisma/schema.postgresql.prisma && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "cross-env NODE_ENV=dev DATABASE_URL=file:./prisma/prisma/dev.db PORT=3000 LOG_LEVEL=debug ts-node-dev --respawn --transpile-only --ignore-watch node_modules src/main.ts",
    "start:prod": "cross-env NODE_ENV=prod node dist/main.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "cross-env NODE_ENV=test jest -c jest.config.js --testPathIgnorePatterns=e2e-spec",
    "test:watch": "cross-env NODE_ENV=test jest -c jest.config.js --watch --testPathIgnorePatterns=e2e-spec",
    "pretest:e2e": "cross-env NODE_ENV=test DATABASE_URL=file:./prisma/prisma/test.db prisma db push",
    "test:e2e": "cross-env NODE_ENV=test DATABASE_URL=file:./prisma/prisma/test.db jest -c jest.config.js --runInBand --testPathPattern=\\.e2e-spec\\.ts$",
    "seed": "ts-node prisma/seed.ts",
    "seed:dev": "cross-env NODE_ENV=dev DATABASE_URL=file:./prisma/prisma/dev.db prisma db push && cross-env NODE_ENV=dev DATABASE_URL=file:./prisma/prisma/dev.db SEED_PURGE=false ts-node prisma/seed.ts",
    "seed:prod": "cross-env NODE_ENV=prod ts-node prisma/seed.ts",
    "prisma:prod": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:push:prod": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "migrate:prod": "prisma migrate deploy --schema=prisma/schema.postgresql.prisma",
    "user:add": "node scripts/manage-user.js add",
    "user:remove": "node scripts/manage-user.js remove",
    "user:list": "node scripts/manage-user.js list"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.1.1",
    "@prisma/client": "6.14.0",
    "@types/compression": "^1.8.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "nest-winston": "^1.10.2",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.1.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.2",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "6.14.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  }
}
