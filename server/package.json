{
  "name": "server",
  "version": "1.3.19",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-pdf-assets.js && node scripts/copy-email-assets.js",
    "build:prod": "prisma generate --schema=prisma/postgresql/schema.prisma && tsc -p tsconfig.json && tsc -p tsconfig.catalog-seed.json && node scripts/copy-pdf-assets.js && node scripts/copy-email-assets.js",
    "start": "node dist/main.js",
    "start:dev": "cross-env NODE_ENV=dev DATABASE_URL=file:./dev.db prisma generate && cross-env NODE_ENV=dev DATABASE_URL=file:./dev.db PORT=3000 LOG_LEVEL=debug ts-node-dev --respawn --transpile-only --ignore-watch node_modules src/main.ts",
    "start:prod": "cross-env NODE_ENV=prod node dist/main.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "cross-env NODE_ENV=test jest -c jest.config.js --testPathIgnorePatterns=e2e-spec",
    "test:watch": "cross-env NODE_ENV=test jest -c jest.config.js --watch --testPathIgnorePatterns=e2e-spec",
    "pretest:e2e": "cross-env NODE_ENV=test DATABASE_URL=file:./test.db node scripts/prisma-migrate-setup.mjs",
    "test:e2e": "cross-env NODE_ENV=test DATABASE_URL=file:./test.db jest -c jest.config.js --runInBand --testPathPattern=\\.e2e-spec\\.ts$",
    "test:e2e:clients-finance": "cross-env NODE_ENV=test DATABASE_URL=file:./test.db jest -c jest.config.js --runInBand --testPathPattern=clients-finance\\.e2e-spec",
    "test:unit:finance": "cross-env NODE_ENV=test jest -c jest.config.js --testPathIgnorePatterns=e2e-spec --testPathPattern \"receivables|payables|invoice-installment-finance|invoice-installments.service|quote-smart-installment\"",
    "test:e2e:finance": "cross-env NODE_ENV=test DATABASE_URL=file:./test.db jest -c jest.config.js --runInBand --testPathPattern \"(receivables|payables|invoice-installments-finance)\\.e2e-spec\"",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "seed:dev": "cross-env NODE_ENV=dev DATABASE_URL=file:./dev.db npm run migrate:setup && cross-env NODE_ENV=dev DATABASE_URL=file:./dev.db SEED_PURGE=false ts-node --transpile-only prisma/seed.ts",
    "seed:playwright": "cross-env NODE_ENV=dev DATABASE_URL=file:./dev.db npm run migrate:setup && cross-env NODE_ENV=dev DATABASE_URL=file:./dev.db ts-node --transpile-only prisma/seed-playwright.ts",
    "seed:catalog:prod": "node dist/catalog-seed/prisma/seed-catalog-prod.js",
    "seed:prod": "npm run seed:catalog:prod",
    "prisma:prod": "prisma generate --schema=prisma/postgresql/schema.prisma",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:baseline": "node scripts/prisma-baseline.mjs --all",
    "migrate:baseline:auto": "node scripts/prisma-baseline.mjs --auto",
    "migrate:baseline:all": "node scripts/prisma-baseline.mjs --all",
    "migrate:setup": "node scripts/prisma-migrate-setup.mjs",
    "migrate:baseline:prod": "node scripts/prisma-baseline.mjs --schema prisma/postgresql/schema.prisma --all",
    "migrate:baseline:prod:auto": "node scripts/prisma-baseline.mjs --schema prisma/postgresql/schema.prisma --auto",
    "migrate:baseline:prod:all": "node scripts/prisma-baseline.mjs --schema prisma/postgresql/schema.prisma --all",
    "migrate:setup:prod": "node scripts/prisma-migrate-setup.mjs --schema prisma/postgresql/schema.prisma",
    "db:push:prod": "prisma db push --schema=prisma/postgresql/schema.prisma",
    "migrate:prod": "prisma migrate deploy --schema=prisma/postgresql/schema.prisma",
    "migrate:prod:dev": "prisma migrate dev --schema=prisma/postgresql/schema.prisma",
    "user:add": "node scripts/manage-user.js add",
    "user:remove": "node scripts/manage-user.js remove",
    "user:list": "node scripts/manage-user.js list",
    "plan:show": "node scripts/set-organization-plan.js show",
    "plan:set": "node scripts/set-organization-plan.js set",
    "plan:list": "node scripts/set-organization-plan.js list",
    "beta:codes": "node scripts/generate-beta-invite-codes.js",
    "beta:codes:list": "node scripts/generate-beta-invite-codes.js list",
    "beta:codes:stats": "node scripts/generate-beta-invite-codes.js stats",
    "beta:welcome-emails": "ts-node --transpile-only scripts/send-beta-welcome-emails.ts",
    "invoices:usage": "node scripts/purge-organization-invoices.js usage",
    "invoices:list": "node scripts/purge-organization-invoices.js list",
    "invoices:purge": "node scripts/purge-organization-invoices.js purge",
    "commercial:stats": "node scripts/purge-organization-commercial.js stats",
    "commercial:purge": "node scripts/purge-organization-commercial.js purge",
    "preview:emails": "ts-node --transpile-only scripts/preview-emails.ts",
    "preview:quote-pdfs": "ts-node --transpile-only scripts/preview-quote-pdfs.ts",
    "test:email:branded": "node scripts/test-email-branded.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.1.1",
    "@prisma/client": "^6.14.0",
    "@types/compression": "^1.8.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "nest-winston": "^1.10.2",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.1.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.2",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.14.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
