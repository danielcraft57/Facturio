{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],
    "outDir": "dist/catalog-seed",
    "rootDir": ".",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": false
  },
  "include": [
    "prisma/seed-catalog-prod.ts",
    "prisma/seeds/products.seed.ts",
    "prisma/seeds/catalog-rules.seed.ts",
    "prisma/seeds/danielcraft-prestations.data.ts",
    "prisma/seeds/dev-products.catalog.ts",
    "prisma/seeds/dev-product.types.ts",
    "src/catalog/tech-assembly.utils.ts",
    "src/catalog/tech-assembly.types.ts"
  ]
}
