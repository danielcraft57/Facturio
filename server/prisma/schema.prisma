generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id                          Int                       @id @default(autoincrement())
  name                        String
  legalName                   String?
  siret                       String?                   @unique
  siren                       String?
  rcs                         String?
  rcsCity                     String?
  vatNumber                   String?                   @unique
  companyStatus               CompanyStatus?
  companyType                 CompanyType               @default(B2B)
  address                     String?
  address2                    String?
  city                        String?
  zipCode                     String?
  country                     String                    @default("FR")
  countryCode                 String                    @default("FR")
  email                       String?
  phone                       String?
  website                     String?
  capital                     Decimal?
  legalForm                   String?
  apeCode                     String?
  apeLabel                    String?
  legalRepresentative         String?
  legalRepresentativeRole     String?
  accountingYearEnd           String?
  fiscalYear                  Int?
  taxRegime                   String?
  urssafRate                  Decimal?
  urssafActivity              String?
  urssafFiscalOption          Boolean                   @default(false)
  urssafDeclarationFrequency  String?
  urssafThreshold             Decimal?
  logo                        String?
  signature                   String?
  defaultCurrency             String                    @default("EUR")
  defaultLanguage             String                    @default("fr")
  timezone                    String                    @default("Europe/Paris")
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  saasPlan                    SaasBillingPlan           @default(FREE)
  saasPlanExpiresAt           DateTime?
  /// Date d'activation du programme beta testeur (3 mois gratuits, accès complet).
  betaTesterAt                DateTime?
  betaInviteRedemption        BetaInviteRedemption?
  stripeCustomerId            String?
  stripeSubscriptionId        String?
  invoiceStripePublishableKey String?
  invoiceStripeSecretKey      String?
  invoiceStripeWebhookSecret  String?
  invoiceStripeConfiguredAt   DateTime?
  privacyPolicyUrl            String?
  dataControllerEmail         String?
  /// JSON : ["card","paypal",…] — voir invoice-stripe-payment-methods.ts
  invoiceStripePaymentMethods String?
  saasSubscriptionStatus      String?
  /// IDs d'options tech-stack (voir server/data/catalog/tech-stack-choices.json)
  preferredTechnologies       Json?
  /// Renseigné après l’assistant post-inscription (stack + installation catalogue)
  onboardingCompletedAt       DateTime?
  /// Profil développeur choisi à l’onboarding (freelance, indie, studio, student, other)
  devProfile                  String?
  amortizations               Amortization[]
  apiAccessTokens             ApiAccessToken[]
  avoirs                      Avoir[]
  refunds                     Refund[]
  clients                     Client[]
  invoices                    Invoice[]
  catalogItems                OrganizationCatalogItem[]
  deliverableCatalogItems     DeliverableCatalogItem[]
  documents                   OrganizationDocument[]
  Pack                        Pack[]
  products                    Product[]
  quotes                      Quote[]
  stripePlatformEvents        StripePlatformEvent[]
  subscriptions               Subscription[]
  taxCredits                  TaxCredit[]
  taxDeductions               TaxDeduction[]
  taxSimulations              TaxSimulation[]
  users                       User[]
  payableCreditors            PayableCreditor[]
  payableDebts                PayableDebt[]

  @@index([siret])
  @@index([siren])
  @@index([vatNumber])
}

/// Code d'invitation beta (réutilisable, ex. DEV26 pour les réseaux sociaux).
model BetaInviteCode {
  id              Int                    @id @default(autoincrement())
  /// 3 à 6 caractères A-Z0-9 — partageable sur les réseaux.
  code            String                 @unique
  /// Libellé campagne (ex. « LinkedIn juin »).
  label           String?
  note            String?
  /// Fin de validité du code (pas la durée d'accès beta par testeur).
  expiresAt       DateTime?
  active          Boolean                @default(true)
  /// Plafond d'inscriptions via ce code (null = seulement le plafond global).
  maxRedemptions  Int?
  redemptionCount Int                    @default(0)
  createdAt       DateTime               @default(now())
  redemptions     BetaInviteRedemption[]

  @@index([active])
}

/// Inscription beta d'une organisation via un code (une fois par org).
model BetaInviteRedemption {
  id               Int            @id @default(autoincrement())
  betaInviteCodeId Int
  organizationId   Int            @unique
  redeemedAt       DateTime       @default(now())
  betaInviteCode   BetaInviteCode @relation(fields: [betaInviteCodeId], references: [id], onDelete: Cascade)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([betaInviteCodeId])
}

/// Jeton d'accès API publique (intégrations tierces, Bearer).
model ApiAccessToken {
  id             Int          @id @default(autoincrement())
  organizationId Int
  name           String
  tokenPrefix    String
  tokenHash      String       @unique
  /// JSON : liste de scopes (ex. clients.read, factures.send)
  permissions    String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model User {
  id                       Int           @id @default(autoincrement())
  email                    String        @unique
  password                 String?
  firstName                String?
  lastName                 String?
  phone                    String?
  avatar                   String?
  role                     UserRole      @default(USER)
  status                   UserStatus    @default(PENDING)
  emailVerified            Boolean       @default(false)
  emailVerifiedAt          DateTime?
  lastLoginAt              DateTime?
  googleId                 String?       @unique
  googleEmail              String?
  googlePicture            String?
  passwordResetToken       String?       @unique
  passwordResetExpires     DateTime?
  emailVerificationToken   String?       @unique
  emailVerificationExpires DateTime?
  organizationId           Int
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  twoFactorEnabled         Boolean       @default(false)
  twoFactorSecret          String?
  privacyConsentAt         DateTime?
  termsAcceptedAt          DateTime?
  documentTagLibrary       Json?
  organization             Organization  @relation(fields: [organizationId], references: [id])
  sessions                 UserSession[]

  @@index([email])
  @@index([googleId])
  @@index([organizationId])
  @@index([passwordResetToken])
  @@index([emailVerificationToken])
}

/// Session navigateur (empreinte appareil, IP hashée) — anti-usurpation / connexions simultanées
model UserSession {
  id                  Int       @id @default(autoincrement())
  userId              Int
  deviceFingerprint   String
  userAgent           String?
  ipHash              String?
  trusted             Boolean   @default(false)
  verifiedAt          DateTime?
  verificationToken   String?   @unique
  verificationExpires DateTime?
  revokedAt           DateTime?
  lastActivityAt      DateTime  @default(now())
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deviceFingerprint])
  @@index([verificationToken])
  @@index([lastActivityAt])
}

/// Journal idempotent des webhooks Stripe plateforme (abonnement Facturio)
model StripePlatformEvent {
  id             Int           @id @default(autoincrement())
  eventId        String        @unique
  type           String
  organizationId Int?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([type])
}

model OrganizationDocument {
  id              Int            @id @default(autoincrement())
  organizationId  Int
  type            DocumentType
  name            String
  description     String?
  filePath        String
  fileName        String
  mimeType        String?
  fileSize        Int?
  status          DocumentStatus @default(PENDING)
  expiresAt       DateTime?
  uploadedBy      Int?
  validatedBy     Int?
  validatedAt     DateTime?
  rejectionReason String?
  metadata        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  TaxDeduction    TaxDeduction[]

  @@index([organizationId])
  @@index([type])
  @@index([status])
}

model Client {
  id                    String              @id
  name                  String
  email                 String              @unique
  phone                 String?
  address               String?
  isCompany             Boolean             @default(false)
  companyName           String?
  siren                 String?
  vatNumber             String?
  isVatExempt           Boolean             @default(false)
  taxRateOverrideId     Int?
  countryCode           String?
  status                ClientStatus        @default(ACTIVE)
  archivedAt            DateTime?
  organizationId        Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  preferredTechnologies Json?
  avoirs                Avoir[]
  organization          Organization?       @relation(fields: [organizationId], references: [id])
  taxRateOverride       TaxRate?            @relation("ClientTaxOverride", fields: [taxRateOverrideId], references: [id])
  catalogItems          ClientCatalogItem[]
  invoices              Invoice[]
  quotes                Quote[]
  subscriptions         Subscription[]

  @@index([email])
  @@index([name])
  @@index([organizationId])
  @@index([status])
  @@index([isCompany])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, isCompany, createdAt])
  @@index([archivedAt])
  @@index([organizationId, archivedAt, createdAt])
}

model Invoice {
  id                  String             @id
  number              String             @unique
  date                DateTime           @default(now())
  dueDate             DateTime?
  operationCategory   String?
  vatOnDebits         Boolean?
  deliveryAddress     String?
  status              InvoiceStatus      @default(DRAFT)
  clientId            String
  subscriptionId      Int?
  organizationId      Int?
  subtotal            Decimal            @default(0)
  tax                 Decimal            @default(0)
  total               Decimal            @default(0)
  balance             Decimal            @default(0)
  currency            String             @default("EUR")
  legalMention        String?
  publicToken         String?            @unique
  sentAt              DateTime?
  sourceQuoteId       String?            @unique
  eInvoiceStatus      EInvoiceStatus     @default(NOT_READY)
  eInvoiceGeneratedAt DateTime?
  eInvoiceXmlHash     String?
  archivedAt          DateTime?
  starred             Boolean            @default(false)
  important           Boolean            @default(false)
  snoozedUntil        DateTime?
  seenAt              DateTime?
  tags                String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  avoirs              Avoir[]            @relation("InvoiceAvoirs")
  appliedAvoirs       AvoirApplication[] @relation("AppliedAvoirs")
  emailEvents         EmailEvent[]
  sourceQuote         Quote?             @relation("QuoteToInvoice", fields: [sourceQuoteId], references: [id])
  organization        Organization?      @relation(fields: [organizationId], references: [id])
  subscription        Subscription?      @relation(fields: [subscriptionId], references: [id])
  client              Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lines               InvoiceLine[]
  payments            Payment[]
  installments        InvoiceInstallment[]
  refunds             Refund[]
  taxDeductions       TaxDeduction[]

  @@index([status, date])
  @@index([clientId])
  @@index([archivedAt])
  @@index([starred])
  @@index([important])
  @@index([number])
  @@index([organizationId])
  @@index([publicToken])
  @@index([eInvoiceStatus])
  @@index([organizationId, archivedAt, createdAt])
  @@index([organizationId, archivedAt, status])
  @@index([organizationId, archivedAt, seenAt])
  @@index([organizationId, archivedAt, snoozedUntil])
  @@index([organizationId, archivedAt, starred])
  @@index([organizationId, archivedAt, important])
  @@index([organizationId, clientId, status])
}

model InvoiceLine {
  id          Int      @id @default(autoincrement())
  invoiceId   String
  productId   Int?
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0)
  taxRate     Decimal  @default(0)
  taxAmount   Decimal  @default(0)
  total       Decimal  @default(0)
  product     Product? @relation(fields: [productId], references: [id])
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Avoir {
  id                Int                @id @default(autoincrement())
  number            String             @unique
  date              DateTime           @default(now())
  status            AvoirStatus        @default(DRAFT)
  invoiceId         String?
  clientId          String
  subtotal          Decimal            @default(0)
  tax               Decimal            @default(0)
  total             Decimal            @default(0)
  appliedAmount     Decimal            @default(0)
  currency          String             @default("EUR")
  legalMention      String?
  accountingEntryId Int?
  organizationId    Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id])
  accountingEntry   JournalEntry?      @relation(fields: [accountingEntryId], references: [id])
  client            Client             @relation(fields: [clientId], references: [id])
  invoice           Invoice?           @relation("InvoiceAvoirs", fields: [invoiceId], references: [id])
  applications      AvoirApplication[]
  lines             AvoirLine[]

  @@index([status, date])
  @@index([clientId])
  @@index([invoiceId])
  @@index([number])
}

model AvoirLine {
  id          Int     @id @default(autoincrement())
  avoirId     Int
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0)
  taxRate     Decimal @default(0)
  taxAmount   Decimal @default(0)
  total       Decimal @default(0)
  avoir       Avoir   @relation(fields: [avoirId], references: [id], onDelete: Cascade)
}

model AvoirApplication {
  id        Int      @id @default(autoincrement())
  avoirId   Int
  invoiceId String
  amount    Decimal  @default(0)
  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  invoice   Invoice  @relation("AppliedAvoirs", fields: [invoiceId], references: [id])
  avoir     Avoir    @relation(fields: [avoirId], references: [id], onDelete: Cascade)

  @@index([avoirId])
  @@index([invoiceId])
}

model Quote {
  id               String        @id
  number           String        @unique
  date             DateTime      @default(now())
  expiryDate       DateTime?
  status           QuoteStatus   @default(DRAFT)
  clientId         String
  organizationId   Int?
  subtotal         Decimal       @default(0)
  tax              Decimal       @default(0)
  total            Decimal       @default(0)
  publicToken      String?       @unique
  sentAt           DateTime?
  acceptedAt       DateTime?
  acceptedIp       String?
  archivedAt       DateTime?
  starred          Boolean       @default(false)
  important        Boolean       @default(false)
  snoozedUntil     DateTime?
  seenAt           DateTime?
  tags             String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  emailEvents      EmailEvent[]
  convertedInvoice Invoice?      @relation("QuoteToInvoice")
  organization     Organization? @relation(fields: [organizationId], references: [id])
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lines            QuoteLine[]
  views            QuoteView[]

  @@index([clientId])
  @@index([status])
  @@index([number])
  @@index([snoozedUntil])
  @@index([seenAt])
  @@index([sentAt])
  @@index([organizationId])
  @@index([archivedAt])
  @@index([starred])
  @@index([important])
  @@index([organizationId, archivedAt, createdAt])
  @@index([organizationId, archivedAt, status])
  @@index([organizationId, archivedAt, seenAt])
  @@index([organizationId, archivedAt, snoozedUntil])
  @@index([organizationId, archivedAt, starred])
  @@index([organizationId, archivedAt, important])
}

model QuoteLine {
  id          Int      @id @default(autoincrement())
  quoteId     String
  productId   Int?
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0)
  taxRate     Decimal  @default(0)
  taxAmount   Decimal  @default(0)
  total       Decimal  @default(0)
  product     Product? @relation(fields: [productId], references: [id])
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model TaxRate {
  id              Int       @id @default(autoincrement())
  name            String
  rate            Decimal
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  clientsOverride Client[]  @relation("ClientTaxOverride")
  productsDefault Product[] @relation("ProductDefaultTaxRate")
}

model Product {
  id                       Int                       @id @default(autoincrement())
  /// null = modèle DanielCraft global ; sinon produit du compte (prix modifiables)
  organizationId           Int?
  templateProductId        Int?
  name                     String
  sku                      String?
  kind                     ProductKind               @default(SERVICE)
  unitPrice                Decimal?
  defaultTaxRateId         Int?
  /// * But métier : site web, SaaS, e-commerce, vitrine
  purpose                  String?
  /// * Catégorie fonctionnelle (SETUP, THEME, DEV, MAINTENANCE, etc.)
  category                 String?
  /// * Langages / technos (liste plate dérivée de techStack)
  languages                Json?
  /// * Assemblage : langages, frontend, backend, CMS, BDD, DevOps, IA, mobile, sécurité
  techStack                Json?
  /// * Points clés (bullet points) stockés en JSON array
  details                  Json?
  /// * Temps estimé en heures pour la prestation
  estimatedHours           Int?
  /// * Description technique détaillée du produit ou service
  description              String?
  /// * Visuel catalogue : icon | library | custom
  visualType               String?                   @default("icon")
  /// * Nom d'icône Font Awesome (ex: cloud, code)
  iconName                 String?
  /// * Clé bibliothèque (library:xxx) ou data URL image personnalisée
  imageData                String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  clientCatalogItems       ClientCatalogItem[]
  invoiceLines             InvoiceLine[]
  organizationCatalogItems OrganizationCatalogItem[]
  plans                    Plan[]                    @relation("PlanProduct")
  defaultTaxRate           TaxRate?                  @relation("ProductDefaultTaxRate", fields: [defaultTaxRateId], references: [id])
  templateProduct          Product?                  @relation("ProductFromTemplate", fields: [templateProductId], references: [id])
  clonedProducts           Product[]                 @relation("ProductFromTemplate")
  organization             Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteLines               QuoteLine[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([templateProductId])
}

/// Livrables réutilisables par organisation (libellé + tarif / durée par défaut).
model DeliverableCatalogItem {
  id             Int          @id @default(autoincrement())
  organizationId Int
  label          String
  labelKey       String
  defaultAmount  Decimal?
  defaultHours   Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, labelKey])
  @@index([organizationId])
}

/// Catalogue produits personnalisé pour une organisation (ex. après inscription).
model OrganizationCatalogItem {
  id             Int          @id @default(autoincrement())
  organizationId Int
  productId      Int
  matchScore     Float        @default(0)
  source         String       @default("algorithm")
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId])
  @@index([organizationId, sortOrder])
}

/// Catalogue produits personnalisé pour un client.
model ClientCatalogItem {
  id         Int      @id @default(autoincrement())
  clientId   String
  productId  Int
  matchScore Float    @default(0)
  source     String   @default("algorithm")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
  @@index([clientId, sortOrder])
}

model Plan {
  id            Int             @id @default(autoincrement())
  productId     Int
  name          String
  amount        Decimal         @default(0)
  currency      String          @default("EUR")
  interval      BillingInterval
  trialDays     Int?
  metered       Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  product       Product         @relation("PlanProduct", fields: [productId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
}

model Subscription {
  id                 Int                @id @default(autoincrement())
  clientId           String
  planId             Int
  organizationId     Int?
  status             SubscriptionStatus @default(ACTIVE)
  quantity           Int                @default(1)
  startDate          DateTime           @default(now())
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  invoices           Invoice[]
  organization       Organization?      @relation(fields: [organizationId], references: [id])
  plan               Plan               @relation(fields: [planId], references: [id])
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Filing {
  id          Int                @id @default(autoincrement())
  type        FilingType
  authority   AuthorityType
  periodStart DateTime
  periodEnd   DateTime
  dueDate     DateTime
  status      FilingStatus       @default(DRAFT)
  notes       String?
  amountDue   Decimal            @default(0)
  amountPaid  Decimal            @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  payments    AuthorityPayment[]
  lines       FilingLine[]
}

model FilingLine {
  id          Int     @id @default(autoincrement())
  filingId    Int
  taxRate     Decimal @default(0)
  taxableBase Decimal @default(0)
  taxAmount   Decimal @default(0)
  filing      Filing  @relation(fields: [filingId], references: [id])
}

model AuthorityPayment {
  id        Int           @id @default(autoincrement())
  filingId  Int?
  authority AuthorityType
  amount    Decimal       @default(0)
  date      DateTime      @default(now())
  reference String?
  notes     String?
  createdAt DateTime      @default(now())
  filing    Filing?       @relation(fields: [filingId], references: [id])
}

enum InvoiceInstallmentStatus {
  SCHEDULED
  PENDING
  PAID
  CANCELLED
}

/// Échéance d'un plan de paiement métier sur une facture (B2B).
model InvoiceInstallment {
  id        Int                      @id @default(autoincrement())
  invoiceId String
  sequence  Int
  amount    Decimal                  @default(0)
  dueDate   DateTime
  status    InvoiceInstallmentStatus @default(PENDING)
  paymentId Int?
  paidAt    DateTime?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  invoice   Invoice                  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment   Payment?                 @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, sequence])
  @@index([invoiceId])
  @@index([invoiceId, status])
  @@index([dueDate])
}

model Payment {
  id                     Int                    @id @default(autoincrement())
  invoiceId              String
  amount                 Decimal                @default(0)
  date                   DateTime               @default(now())
  method                 String?
  notes                  String?
  createdAt              DateTime               @default(now())
  invoice                Invoice                @relation(fields: [invoiceId], references: [id])
  installmentAllocations InvoiceInstallment[]
  refunds                Refund[]
}

enum PayableDebtStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

/// Personne ou entité à qui l'organisation doit de l'argent (famille, fournisseur informel, etc.).
model PayableCreditor {
  id             Int           @id @default(autoincrement())
  organizationId Int
  name           String
  email          String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debts          PayableDebt[]

  @@index([organizationId])
}

/// Dette à régler (montant initial + solde restant).
model PayableDebt {
  id             Int                 @id @default(autoincrement())
  organizationId Int
  creditorId     Int
  label          String
  totalAmount    Decimal             @default(0)
  balance        Decimal             @default(0)
  currency       String              @default("EUR")
  dueDate        DateTime?
  status         PayableDebtStatus   @default(OPEN)
  notes          String?
  publicToken    String?             @unique
  archivedAt     DateTime?
  starred        Boolean             @default(false)
  important      Boolean             @default(false)
  snoozedUntil   DateTime?
  seenAt         DateTime?
  sentAt         DateTime?
  tags           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditor       PayableCreditor     @relation(fields: [creditorId], references: [id], onDelete: Cascade)
  payments       PayableDebtPayment[]
  emailEvents    EmailEvent[]

  @@index([organizationId])
  @@index([creditorId])
  @@index([status])
  @@index([publicToken])
  @@index([archivedAt])
  @@index([starred])
  @@index([important])
  @@index([seenAt])
  @@index([sentAt])
  @@index([organizationId, archivedAt, createdAt])
}

model PayableDebtPayment {
  id        Int         @id @default(autoincrement())
  debtId    Int
  amount    Decimal     @default(0)
  date      DateTime    @default(now())
  method    String?
  notes     String?
  createdAt DateTime    @default(now())
  debt      PayableDebt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Remboursement client (encaissement inversé) — lié à une facture et optionnellement à un paiement.
model Refund {
  id             Int          @id @default(autoincrement())
  invoiceId      String
  paymentId      Int?
  organizationId Int
  amount         Decimal      @default(0)
  date           DateTime     @default(now())
  method         String?
  reason         String?
  notes          String?
  stripeRefundId String?
  status         RefundStatus @default(COMPLETED)
  createdAt      DateTime     @default(now())
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  payment        Payment?     @relation(fields: [paymentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([invoiceId])
  @@index([paymentId])
  @@index([organizationId])
}

model Counter {
  id      Int    @id @default(autoincrement())
  scope   String @unique
  current Int    @default(0)
}

model EmailEvent {
  id            Int          @id @default(autoincrement())
  quoteId       String?
  invoiceId     String?
  payableDebtId Int?
  type          String
  providerId    String?
  meta          Json?
  createdAt     DateTime     @default(now())
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])
  quote         Quote?       @relation(fields: [quoteId], references: [id])
  payableDebt   PayableDebt? @relation(fields: [payableDebtId], references: [id], onDelete: Cascade)
}

model QuoteView {
  id        Int      @id @default(autoincrement())
  quoteId   String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  quote     Quote    @relation(fields: [quoteId], references: [id])
}

model Account {
  id        Int           @id @default(autoincrement())
  code      String        @unique
  name      String
  type      AccountType
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  lines     JournalLine[]
}

model Journal {
  id        Int            @id @default(autoincrement())
  code      String         @unique
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  entries   JournalEntry[]
}

model JournalEntry {
  id          Int           @id @default(autoincrement())
  journalId   Int
  date        DateTime      @default(now())
  reference   String?
  memo        String?
  status      EntryStatus   @default(DRAFT)
  totalDebit  Decimal       @default(0)
  totalCredit Decimal       @default(0)
  createdAt   DateTime      @default(now())
  avoirs      Avoir[]
  journal     Journal       @relation(fields: [journalId], references: [id])
  lines       JournalLine[]
}

model JournalLine {
  id          Int          @id @default(autoincrement())
  entryId     Int
  accountId   Int
  description String?
  debit       Decimal      @default(0)
  credit      Decimal      @default(0)
  account     Account      @relation(fields: [accountId], references: [id])
  entry       JournalEntry @relation(fields: [entryId], references: [id])
}

model Pack {
  id             Int           @id @default(autoincrement())
  name           String
  type           PackType
  description    String
  details        String
  products       String?
  totalHours     Int           @default(0)
  totalPrice     Decimal       @default(0)
  isTemplate     Boolean       @default(false)
  templateId     String?
  features       String?
  deliveryTime   Int?
  organizationId Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model TaxDeduction {
  id             Int                   @id @default(autoincrement())
  organizationId Int
  category       TaxDeductionCategory
  name           String
  description    String?
  amount         Decimal
  year           Int
  deductibleRate Decimal               @default(1.0)
  invoiceId      String?
  documentId     Int?
  status         TaxDeductionStatus    @default(PENDING)
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  document       OrganizationDocument? @relation(fields: [documentId], references: [id])
  invoice        Invoice?              @relation(fields: [invoiceId], references: [id])
  organization   Organization          @relation(fields: [organizationId], references: [id])

  @@index([organizationId, year])
  @@index([status])
}

model Amortization {
  id               Int                @id @default(autoincrement())
  organizationId   Int
  assetName        String
  assetDescription String?
  purchaseDate     DateTime
  purchaseAmount   Decimal
  residualValue    Decimal            @default(0)
  method           AmortizationMethod
  duration         Int
  coefficient      Decimal?
  startYear        Int
  endYear          Int?
  schedule         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id])

  @@index([organizationId, startYear])
}

model TaxCredit {
  id             Int             @id @default(autoincrement())
  organizationId Int
  type           TaxCreditType
  name           String
  description    String?
  eligibleAmount Decimal
  rate           Decimal
  creditAmount   Decimal
  year           Int
  status         TaxCreditStatus @default(ELIGIBLE)
  documents      Json?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id])

  @@index([organizationId, year])
  @@index([type, status])
}

model TaxSimulation {
  id             Int                   @id @default(autoincrement())
  organizationId Int
  scenario       TaxSimulationScenario
  year           Int
  name           String?
  revenue        Decimal
  expenses       Decimal
  deductions     Decimal
  amortizations  Decimal
  credits        Decimal
  taxableIncome  Decimal
  corporateTax   Decimal
  cfe            Decimal
  totalTax       Decimal
  effectiveRate  Decimal
  optimizations  Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id])

  @@index([organizationId, year])
  @@index([scenario])
}

