{
  "version": 2,
  "maxCatalogItems": 12,
  "budgetMaxUnitPrice": 400,
  "alwaysIncludeSkus": ["ADDON-SEO-BASIQUE", "ADDON-PAGE-SUPP", "ADDON-DEPANNAGE-2H"],
  "starterProfileSkus": [
    "STACK-WEB-STATIC",
    "ADDON-SEO-BASIQUE",
    "ADDON-PAGE-SUPP",
    "STACK-MAINT-MENSUEL",
    "ADDON-FORMATION"
  ],
  "rules": [
    {
      "id": "fullstack-ts",
      "whenAnyOption": ["typescript", "react", "nestjs", "nodejs"],
      "skus": ["STACK-MVP-REACT-NEST", "STACK-NEXT-SUPABASE", "STACK-API-GRAPHQL-TS", "STACK-DOCKER-CICD"],
      "weight": 10
    },
    {
      "id": "react-next",
      "whenAnyOption": ["react", "nextjs", "remix"],
      "skus": ["STACK-NEXT-LANDING", "STACK-NEXT-SUPABASE", "STACK-MVP-REACT-NEST"],
      "weight": 9
    },
    {
      "id": "vue-nuxt",
      "whenAnyOption": ["vue", "nuxt"],
      "skus": ["STACK-NUXT-SITE", "STACK-VUE-DASHBOARD"],
      "weight": 9
    },
    {
      "id": "python-stack",
      "whenAnyOption": ["python", "fastapi", "django"],
      "skus": ["STACK-FASTAPI-API", "STACK-DJANGO-PORTAL", "STACK-RAG-LANGCHAIN"],
      "weight": 9
    },
    {
      "id": "php-cms",
      "whenAnyOption": ["php", "wordpress", "laravel", "prestashop"],
      "skus": ["STACK-WP-VITRINE", "STACK-LARAVEL-APP", "STACK-PRESTASHOP-BOUTIQUE"],
      "weight": 9
    },
    {
      "id": "shopify-ecom",
      "whenAnyOption": ["shopify"],
      "skus": ["STACK-SHOPIFY-THEME", "STACK-CHATBOT-WEB", "ADDON-SEO-BASIQUE"],
      "weight": 8
    },
    {
      "id": "ai-stack",
      "whenAnyOption": ["chatgpt", "claude", "langchain", "n8n"],
      "skus": ["STACK-CHATBOT-WEB", "STACK-N8N-WORKFLOW", "STACK-CLAUDE-INTEG", "STACK-RAG-LANGCHAIN"],
      "weight": 10
    },
    {
      "id": "static-vitrine",
      "whenAnyOption": ["html-css", "javascript", "webflow"],
      "skus": ["STACK-WEB-STATIC", "ADDON-SEO-BASIQUE", "ADDON-PAGE-SUPP"],
      "weight": 10
    },
    {
      "id": "mobile",
      "whenAnyOption": ["react-native", "flutter", "swift", "kotlin"],
      "skus": ["STACK-RN-APP", "STACK-FLUTTER-APP"],
      "weight": 9
    },
    {
      "id": "devops",
      "whenAnyOption": ["docker", "kubernetes", "aws", "nginx", "github-actions", "vercel"],
      "skus": ["STACK-DOCKER-CICD", "STACK-K8S-DEPLOY", "STACK-AWS-LIGHT"],
      "weight": 8
    },
    {
      "id": "databases",
      "whenAnyOption": ["postgresql", "mysql", "mongodb", "supabase", "firebase"],
      "skus": ["STACK-NEXT-SUPABASE", "STACK-MVP-REACT-NEST", "STACK-FASTAPI-API"],
      "weight": 7
    },
    {
      "id": "security",
      "whenAnyOption": ["owasp", "pentest", "snyk", "sonarqube", "waf", "vault"],
      "skus": ["STACK-AUDIT-SECU", "STACK-PENTEST-APP"],
      "weight": 9
    },
    {
      "id": "support-maint",
      "whenAnyOption": ["nodejs", "typescript", "react"],
      "skus": ["STACK-MAINT-MENSUEL", "STACK-SUPPORT-ABO", "ADDON-ACCOMP-H"],
      "weight": 5
    }
