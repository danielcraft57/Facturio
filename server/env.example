# ========================================
# CONFIGURATION GÉNÉRALE
# ========================================
# Copier ce fichier vers .env.dev, .env.test ou .env.prod selon l'environnement

# Environnement (dev, test, prod)
NODE_ENV=dev

# Port du serveur
PORT=3000

# Base de données
DATABASE_URL=file:./prisma/dev.db

# Logging (debug, info, warn, error)
LOG_LEVEL=debug

# ========================================
# URLS ET CORS
# ========================================

# Frontend URL (pour les emails/liens)
FRONTEND_URL=http://localhost:5173

# URL publique de l'application (pour les liens publics, ex: devis)
PUBLIC_APP_URL=http://localhost:3000

# CORS - Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ========================================
# AUTHENTIFICATION
# ========================================

# Secret JWT (à changer en production !)
JWT_SECRET=your-secret-key-change-in-production

# Google OAuth 2.0
# Obtenir les clés sur : https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ========================================
# TAXES ET IMPÔTS
# ========================================

# Taux de TVA par défaut (0.2 = 20%)
DEFAULT_VAT_RATE=0.2

# Impôt sur les Sociétés (IS)
# Tranche 1 : 0 à 38 120€
IS_RATE_TRANCHE_1=0.15
IS_THRESHOLD_TRANCHE_1=38120
# Tranche 2 : 38 120€ à 75 000€
IS_RATE_TRANCHE_2=0.28
IS_THRESHOLD_TRANCHE_2=75000
# Tranche 3 : au-delà de 75 000€
IS_RATE_TRANCHE_3=0.31

# Impôt sur le Revenu (IR) - Barème progressif
# Tranche 1 : 0 à 10 777€
IR_RATE_TRANCHE_1=0
IR_THRESHOLD_TRANCHE_1=10777
# Tranche 2 : 10 777€ à 27 478€
IR_RATE_TRANCHE_2=0.11
IR_THRESHOLD_TRANCHE_2=27478
# Tranche 3 : 27 478€ à 78 570€
IR_RATE_TRANCHE_3=0.30
IR_THRESHOLD_TRANCHE_3=78570
# Tranche 4 : 78 570€ à 168 994€
IR_RATE_TRANCHE_4=0.41
IR_THRESHOLD_TRANCHE_4=168994
# Tranche 5 : au-delà de 168 994€
IR_RATE_TRANCHE_5=0.45

# Charges sociales
SOCIAL_RATE_EMPLOYEE=0.22
SOCIAL_RATE_EMPLOYER=0.45

# ========================================
# URSSAF
# ========================================

# Taux URSSAF par défaut (auto-entrepreneur)
# Vente de marchandises
URSSAF_RATE_VENTE=0.128
URSSAF_THRESHOLD_VENTE=72600

# Prestations de services BIC
URSSAF_RATE_SERVICE_BIC=0.22
URSSAF_THRESHOLD_SERVICE_BIC=176200

# Prestations de services BNC
URSSAF_RATE_SERVICE_BNC=0.22
URSSAF_THRESHOLD_SERVICE_BNC=176200

# Taux micro-fiscal (option micro-fiscal)
URSSAF_FISCAL_RATE_VENTE=0.01
URSSAF_FISCAL_RATE_SERVICE_BIC=0.017
URSSAF_FISCAL_RATE_SERVICE_BNC=0.022
