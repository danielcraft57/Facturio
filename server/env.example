# ========================================
# CHIFFREMENT DES SECRETS (BDD)
# ========================================
# Clé 32 octets en hex (64 caractères) ou passphrase — chiffre invoiceStripeSecretKey / webhook en BDD.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECRETS_ENCRYPTION_KEY=

# ========================================
# CONFIGURATION GÉNÉRALE
# ========================================
# Dev : copier vers .env (SQLite par défaut).
# Prod : voir env.prod.example (PostgreSQL).

# Environnement (dev, test, prod)
NODE_ENV=dev

# Port du serveur
PORT=3000

# Base de données
# Dev : SQLite (fichier local)
DATABASE_URL=file:./dev.db
# Prod : PostgreSQL (voir env.prod.example)
# DATABASE_URL=postgresql://facturio:MOT_DE_PASSE@localhost:5432/facturio

# Logging (debug, info, warn, error)
LOG_LEVEL=debug

# ========================================
# URLS ET CORS
# ========================================

# Frontend URL (pour les emails/liens)
FRONTEND_URL=http://localhost:5173

# URL publique du FRONTEND (Vite en dev : 5173, pas le port API 3000)
# Utilisée dans les emails : lien « Voir et payer » → /facture/:token
PUBLIC_APP_URL=http://localhost:5173

# URL de l'API (pour les liens de tracking et PDF dans les emails)
API_URL=http://localhost:3000

# CORS - Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ========================================
# AUTHENTIFICATION
# ========================================

# Secret JWT (à changer en production !)
JWT_SECRET=your-secret-key-change-in-production

# Google OAuth 2.0 (type « Application Web »)
# https://console.cloud.google.com/apis/credentials
# ID client : …apps.googleusercontent.com — ne pas mettre de valeur GOCSPX-… ici.
# Secret client : souvent GOCSPX-…
GOOGLE_CLIENT_ID=123456789012-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ========================================
# TAXES ET IMPÔTS
# ========================================

# Taux de TVA par défaut (0.2 = 20%)
DEFAULT_VAT_RATE=0.2

# Impôt sur les Sociétés (IS)
# Tranche 1 : 0 à 38 120€
IS_RATE_TRANCHE_1=0.15
IS_THRESHOLD_TRANCHE_1=38120
# Tranche 2 : 38 120€ à 75 000€
IS_RATE_TRANCHE_2=0.28
IS_THRESHOLD_TRANCHE_2=75000
# Tranche 3 : au-delà de 75 000€
IS_RATE_TRANCHE_3=0.31

# Impôt sur le Revenu (IR) - Barème progressif
# Tranche 1 : 0 à 10 777€
IR_RATE_TRANCHE_1=0
IR_THRESHOLD_TRANCHE_1=10777
# Tranche 2 : 10 777€ à 27 478€
IR_RATE_TRANCHE_2=0.11
IR_THRESHOLD_TRANCHE_2=27478
# Tranche 3 : 27 478€ à 78 570€
IR_RATE_TRANCHE_3=0.30
IR_THRESHOLD_TRANCHE_3=78570
# Tranche 4 : 78 570€ à 168 994€
IR_RATE_TRANCHE_4=0.41
IR_THRESHOLD_TRANCHE_4=168994
# Tranche 5 : au-delà de 168 994€
IR_RATE_TRANCHE_5=0.45

# Charges sociales
SOCIAL_RATE_EMPLOYEE=0.22
SOCIAL_RATE_EMPLOYER=0.45

# ========================================
# URSSAF
# ========================================

# Taux URSSAF par défaut (auto-entrepreneur)
# Vente de marchandises
URSSAF_RATE_VENTE=0.128
URSSAF_THRESHOLD_VENTE=72600

# Prestations de services BIC
URSSAF_RATE_SERVICE_BIC=0.22
URSSAF_THRESHOLD_SERVICE_BIC=176200

# Prestations de services BNC
URSSAF_RATE_SERVICE_BNC=0.22
URSSAF_THRESHOLD_SERVICE_BNC=176200

# Taux micro-fiscal (option micro-fiscal)
URSSAF_FISCAL_RATE_VENTE=0.01
URSSAF_FISCAL_RATE_SERVICE_BIC=0.017
URSSAF_FISCAL_RATE_SERVICE_BNC=0.022

# ========================================
# PROSPECTLAB (prospection externe)
# ========================================
# Créer un token sur : https://prospectlab.danielcraft.fr/tokens
# Permissions recommandées : Lire les entreprises
PROSPECTLAB_API_URL=https://prospectlab.danielcraft.fr
# PROSPECTLAB_API_KEY=

# ========================================
# EMAIL ET MENTIONS LÉGALES
# ========================================
# SMTP : utilisé pour vérification email (inscription), mot de passe oublié, factures, devis.
# Dev : Mailpit (localhost:1025) ou SMTP de test. Prod : configurer un vrai serveur SMTP.
#
# Images dans les emails : si FRONTEND_URL est localhost, logo/bandeaux sont intégrés
# en pièces jointes inline (CID) — Gmail ne peut pas charger http://localhost:5173/...
# EMAIL_IMAGES_INLINE=true   # forcer CID même avec une URL publique
# EMAIL_IMAGES_INLINE=false  # URLs distantes uniquement (prod déployée)

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Authentification (optionnel selon le serveur)
# SMTP_USER=
# SMTP_PASS=
# Certificat TLS (mettre false si serveur avec certificat auto-signé)
# SMTP_REJECT_UNAUTHORIZED=false

# Expéditeur par défaut (relances, etc.)
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Facturio

# Comptes dédiés : factures et devis
MAIL_FROM_INVOICE=facture@danielcraft.fr
MAIL_FROM_INVOICE_NAME=Facturio Factures
MAIL_FROM_QUOTE=devis@danielcraft.fr
MAIL_FROM_QUOTE_NAME=Facturio Devis
# Factures d'abonnement Facturio (Stripe plateforme) — défaut : MAIL_FROM_INVOICE
# MAIL_FROM_SUBSCRIPTION=abonnement@danielcraft.fr
# MAIL_FROM_SUBSCRIPTION_NAME=Facturio Abonnements

# Entreprise (mentions légales dans les emails et PDF)
COMPANY_NAME=Loïc DANIEL
COMPANY_ADDRESS=57000 Metz, France
COMPANY_SIRET=823 417 050 000 23
COMPANY_VAT=Non assujetti à la TVA, art. 293 B du CGI
COMPANY_PHONE=03 87 78 09 16
COMPANY_EMAIL=contact@danielcraft.fr
# IBAN affiché dans le PDF (section paiement)
# COMPANY_IBAN=FR76 XXXX XXXX XXXX XXXX XXXX XXX
# LEGAL_MENTIONS= (optionnel, texte libre)
# Signature sur les factures d'abonnement Facturio (PDF) :
# chemin fichier image (PNG/JPG) ou data URL base64, ou texte (nom du signataire)
# SUBSCRIPTION_SIGNATURE=/chemin/vers/signature.png
# PLATFORM_SIGNATURE= (alias accepté)

# ========================================
# STRIPE PLATEFORME (abonnement Facturio Pro uniquement)
# ========================================
# Compte Stripe DanielCraft / éditeur — NE PAS utiliser pour les paiements
# des factures clients (voir Paramètres → Stripe prestataire en BDD par org).
# Clés : https://dashboard.stripe.com/apikeys
#
# Webhook local :
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe/platform
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Personnalisation Stripe Checkout (https://docs.stripe.com/payments/checkout/customize)
# STRIPE_CHECKOUT_DISPLAY_NAME=Facturio
# STRIPE_CHECKOUT_BORDER_STYLE=rounded
# (ancien nom accepté : STRIPE_CHECKOUT_BORDER_RADIUS)
# STRIPE_CHECKOUT_FONT_FAMILY=roboto
# Logo : uploader un fichier image dans Stripe (API Files) puis coller l’id file_…
# STRIPE_CHECKOUT_LOGO_FILE_ID=file_…
# Moyens de paiement (liste stricte — pas de Klarna). PayPal : activer dans Dashboard Stripe.
# STRIPE_CHECKOUT_PAYMENT_METHODS=card,paypal

# URL de retour après Checkout Pro (optionnel)
# BILLING_CHECKOUT_SUCCESS_URL=http://localhost:5173/parametres/abonnement?billing=success
# BILLING_CHECKOUT_CANCEL_URL=http://localhost:5173/parametres/abonnement?billing=cancelled

# ========================================
# Relances échéancier facture (cron 8h) — INSTALLMENT_REMINDERS_ENABLED=0 pour désactiver
# INSTALLMENT_REMINDER_DAYS_BEFORE=3
# INSTALLMENT_REMINDER_OVERDUE_INTERVAL_DAYS=7

# STRIPE PRESTATAIRE (paiement factures clients)
# ========================================
# Configuré par chaque organisation dans l'app (invoiceStripe* en BDD).
# Webhook par org : POST /api/webhooks/stripe/invoices/{organizationId}
# Secret whsec_… saisi dans Paramètres avec les clés pk_/sk_ du compte prestataire.
# RGPD : DPA Stripe signé par le prestataire, pas par Facturio pour ce flux.
