# ========================================
# FACTURIO - PRODUCTION
# ========================================
# Copier vers .env sur le serveur de production.
# En dev : utiliser .env avec SQLite (voir env.example).
# En prod : utiliser ce fichier ou .env avec PostgreSQL.
# Remplacer tous les placeholders (YOUR_*) par vos valeurs.

# Optionnel : sur Raspberry Pi 32-bit (armv7l), si Prisma echoue au telechargement des engines (404),
# decommente la ligne suivante pour ignorer la verification du checksum :
# PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1

NODE_ENV=prod
PORT=3000

# PostgreSQL (production)
# Créer l'utilisateur et la base : CREATE USER facturio WITH PASSWORD 'YOUR_POSTGRES_PASSWORD'; CREATE DATABASE facturio OWNER facturio;
DATABASE_URL="postgresql://facturio:YOUR_POSTGRES_PASSWORD@localhost:5432/facturio"

LOG_LEVEL=info

# URLs publiques (remplacer YOUR_DOMAIN par votre domaine, ex: example.fr)
FRONTEND_URL=https://facturio.YOUR_DOMAIN
PUBLIC_APP_URL=https://facturio.YOUR_DOMAIN
API_URL=https://facturio.YOUR_DOMAIN/api

CORS_ORIGIN=https://facturio.YOUR_DOMAIN,https://devis.YOUR_DOMAIN,https://facture.YOUR_DOMAIN

# Acces public (derriere reverse proxy) : autoriser les requetes qui ne viennent pas de localhost
ALLOW_PUBLIC_ACCESS=true

# JWT (générer une clé unique en prod)
JWT_SECRET=YOUR_JWT_SECRET

# SMTP
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USER
SMTP_PASS=YOUR_SMTP_PASS
MAIL_FROM=YOUR_MAIL_FROM
MAIL_FROM_NAME=Facturio
MAIL_FROM_INVOICE=YOUR_MAIL_FROM_INVOICE
MAIL_FROM_INVOICE_NAME=Facturio Factures
MAIL_FROM_QUOTE=YOUR_MAIL_FROM_QUOTE
MAIL_FROM_QUOTE_NAME=Facturio Devis

# Entreprise (mentions légales)
COMPANY_NAME=YOUR_COMPANY_NAME
COMPANY_ADDRESS=YOUR_COMPANY_ADDRESS
COMPANY_SIRET=YOUR_COMPANY_SIRET
COMPANY_VAT=YOUR_COMPANY_VAT
COMPANY_PHONE=YOUR_COMPANY_PHONE
COMPANY_EMAIL=YOUR_COMPANY_EMAIL

# Stripe (paiement en ligne sur factures publiques)
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
