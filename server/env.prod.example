# ========================================
# PRESTAFACTURE - PRODUCTION
# ========================================
# Sur le serveur : cp env.prod.example .env puis remplacer YOUR_* / générer les secrets.
# Ne jamais committer .env ni .env.prod (déjà dans .gitignore).

# --- Runtime Node ---
NODE_ENV=prod
PORT=3000
# Limite mémoire V8 (VPS 2 Go : 512–768 Mo)
NODE_OPTIONS=--max-old-space-size=512
LOG_LEVEL=info

# --- PostgreSQL (obligatoire en prod) ---
# Création : voir docs/deployment/POSTGRESQL_PRODUCTION.md
# Utiliser 127.0.0.1 (pas localhost) pour éviter le socket Unix si besoin.
# Les paramètres ?schema=…&connection_limit=… sont ajoutés automatiquement si absents.
DATABASE_URL="postgresql://facturio:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/facturio?schema=public"
# DATABASE_POOL_SIZE=8
# DATABASE_POOL_TIMEOUT_SEC=20
# DATABASE_CONNECT_TIMEOUT_SEC=10
# DATABASE_APP_NAME=facturio_api

# --- Chiffrement secrets Stripe org en BDD (obligatoire en prod) ---
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=YOUR_64_HEX_CHARS

# --- URLs publiques ---
FRONTEND_URL=https://prestafacture.com
PUBLIC_APP_URL=https://prestafacture.com
API_URL=https://prestafacture.com/api
API_PUBLIC_URL=https://prestafacture.com/api

CORS_ORIGIN=https://prestafacture.com,https://devis.prestafacture.com,https://facture.prestafacture.com

# Derrière reverse proxy HTTPS (Nginx)
ALLOW_PUBLIC_ACCESS=true

# --- Auth ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=YOUR_JWT_SECRET

GOOGLE_CLIENT_ID=123456789012-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_CALLBACK_URL=https://prestafacture.com/api/auth/google/callback

# --- SMTP (mail.prestafacture.com) ---
# Guide DKIM / DMARC : docs/deployment/MAIL_DKIM_PRESTAFACTURE.md
SMTP_HOST=mail.prestafacture.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=facture
SMTP_PASS=YOUR_SMTP_PASS
MAIL_FROM=no-reply@prestafacture.com
MAIL_FROM_NAME=PrestaFacture
MAIL_FROM_INVOICE=facture@prestafacture.com
MAIL_FROM_INVOICE_NAME=PrestaFacture Factures
MAIL_FROM_QUOTE=devis@prestafacture.com
MAIL_FROM_QUOTE_NAME=PrestaFacture Devis
MAIL_FROM_SUBSCRIPTION=no-reply@prestafacture.com
MAIL_FROM_SUBSCRIPTION_NAME=PrestaFacture Abonnements

# --- Mentions légales (PDF / emails) ---
COMPANY_NAME=YOUR_COMPANY_NAME
COMPANY_ADDRESS=YOUR_COMPANY_ADDRESS
COMPANY_SIRET=YOUR_COMPANY_SIRET
COMPANY_VAT=YOUR_COMPANY_VAT
COMPANY_PHONE=YOUR_COMPANY_PHONE
COMPANY_EMAIL=YOUR_COMPANY_EMAIL

# --- Stripe plateforme (abonnement PrestaFacture Pro) ---
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
# Secret whsec_… depuis Dashboard → Webhooks → POST /api/webhooks/stripe (pas une URL)
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CHECKOUT_PAYMENT_METHODS=card,paypal
# STRIPE_CHECKOUT_DISPLAY_NAME=PrestaFacture
# STRIPE_CHECKOUT_BORDER_STYLE=rounded
# STRIPE_CHECKOUT_FONT_FAMILY=roboto
# SUBSCRIPTION_SIGNATURE=/chemin/signature.png

# --- Taxes / URSSAF (valeurs par défaut France — ajuster si besoin) ---
DEFAULT_VAT_RATE=0.2
